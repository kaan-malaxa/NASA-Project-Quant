{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "Feature"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "membership": {
                "enum": [
                  "polygon",
                  "bbox"
                ]
              },
              "kind": {
                "$ref": "common.schema.json#/$defs/kind"
              }
            },
            "required": []
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "Polygon",
                  "MultiPolygon"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array"
                }
              }
            },
            "required": [
              "type",
              "coordinates"
            ]
          }
        },
        "required": [
          "type",
          "properties",
          "geometry"
        ]
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "type",
    "features"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis outline, separate from display longitude wrapping"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "period_index",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/generated_at"
    },
    "code_version": {
      "$ref": "common.schema.json#/$defs/code_version"
    },
    "region": {
      "$ref": "common.schema.json#/$defs/region_id"
    },
    "available_years": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "default_years": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year_range"
        },
        {
          "type": "null"
        }
      ]
    },
    "anomaly_baseline_years": {
      "$ref": "common.schema.json#/$defs/year_range"
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "years": {
            "$ref": "common.schema.json#/$defs/year_range"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z_]+/[0-9-]+\\.json$"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "years",
          "path",
          "sha256",
          "bytes"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "region",
    "available_years",
    "default_years",
    "anomaly_baseline_years",
    "periods"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World country source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "code_version", "source_sha256", "countries", "products"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "generated_at": { "$ref": "common.schema.json#/$defs/generated_at" },
    "code_version": { "$ref": "common.schema.json#/$defs/code_version" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "enum": ["modis", "viirs-snpp", "viirs-jpss1"] },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "firms_name", "records"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "firms_name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["product", "year", "detections", "kind", "first_date", "last_date", "csv_sha256", "url"],
              "properties": {
                "product": { "enum": ["modis", "viirs-snpp", "viirs-jpss1"] },
                "year": { "type": "integer", "minimum": 2000 },
                "detections": { "type": "integer", "minimum": 0 },
                "kind": { "const": "observed" },
                "first_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "last_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "csv_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "url": { "type": "string", "pattern": "^https://firms\\.modaps\\.eosdis\\.nasa\\.gov/data/country/(modis|viirs-snpp|viirs-jpss1)/[0-9]{4}/[A-Za-z0-9_-]+\\.csv$" }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "regions.json — contracts 6.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "regions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/generated_at"
    },
    "code_version": {
      "$ref": "common.schema.json#/$defs/code_version"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "country",
          "bbox",
          "centroid",
          "fire_type",
          "story",
          "n_cells_r6",
          "membership",
          "last_data_day",
          "synthetic",
          "files",
          "optional_files"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/region_id"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "centroid": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fire_type": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "n_cells_r6": {
            "type": "integer",
            "minimum": 0
          },
          "membership": {
            "$ref": "common.schema.json#/$defs/membership"
          },
          "last_data_day": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "synthetic": {
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/region_file"
            },
            "uniqueItems": true
          },
          "optional_files": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/region_file"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

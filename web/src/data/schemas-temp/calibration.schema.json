{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "calibration (TEMPORARY, R5; replace with contracts/calibration.schema.json from R1)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "region",
    "reference",
    "count_resolution",
    "shrinkage_n0",
    "eras",
    "fit_window",
    "noaa20_method",
    "k_annual",
    "k"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "count_resolution": {
      "type": "integer"
    },
    "shrinkage_n0": {
      "type": "number"
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "source",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "observed",
              "harmonized",
              "estimated",
              "missing",
              "sample"
            ]
          }
        }
      }
    },
    "fit_window": {
      "type": "object"
    },
    "noaa20_method": {
      "type": "string"
    },
    "k_annual": {
      "type": "object"
    },
    "k": {
      "type": "object"
    }
  }
}

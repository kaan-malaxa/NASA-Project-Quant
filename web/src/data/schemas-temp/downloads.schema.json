{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "downloads (TEMPORARY, R5; replace with contracts/downloads.schema.json from R1)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "region",
    "hotspot_archives"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "hotspot_archives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "year",
          "sensor",
          "url",
          "rows",
          "bytes"
        ],
        "properties": {
          "year": {
            "type": "integer"
          },
          "sensor": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "rows": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          }
        }
      }
    }
  }
}

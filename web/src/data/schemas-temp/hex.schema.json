{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hex (TEMPORARY, R5; replace with contracts/hex.schema.json from R1)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "region",
    "resolution",
    "unit",
    "source",
    "years",
    "kind",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "resolution": {
      "type": "integer"
    },
    "unit": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "years": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "kind": {
      "enum": [
        "observed",
        "harmonized",
        "estimated",
        "missing",
        "sample"
      ]
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "h3",
          "critical",
          "all_year"
        ],
        "properties": {
          "h3": {
            "type": "string"
          },
          "critical": {
            "type": [
              "number",
              "null"
            ]
          },
          "all_year": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "manifest (TEMPORARY, R5; replace with contracts/manifest.schema.json from R1)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "contains_sample",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "contains_sample": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes",
          "kinds"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "observed",
                "harmonized",
                "estimated",
                "missing",
                "sample"
              ]
            }
          }
        }
      }
    }
  }
}

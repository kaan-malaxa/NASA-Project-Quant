{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "outline.geojson (R5; contracts/ has no schema for this file)",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    }
  }
}

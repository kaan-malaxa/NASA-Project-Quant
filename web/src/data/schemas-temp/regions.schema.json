{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "regions (TEMPORARY, R5; replace with contracts/regions.schema.json from R1)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "regions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "country",
          "bbox",
          "centroid",
          "fire_type",
          "story",
          "n_cells_r6",
          "membership",
          "last_data_day",
          "synthetic",
          "files",
          "optional_files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "centroid": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fire_type": {
            "type": "string"
          },
          "story": {
            "type": "string"
          },
          "n_cells_r6": {
            "type": "integer"
          },
          "membership": {
            "enum": [
              "polygon",
              "bbox"
            ]
          },
          "last_data_day": {
            "type": "string"
          },
          "synthetic": {
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

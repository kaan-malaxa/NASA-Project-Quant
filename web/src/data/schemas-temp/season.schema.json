{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "season (TEMPORARY, R5; replace with contracts/season.schema.json from R1)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "region",
    "definition",
    "critical_weeks",
    "windows"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "critical_weeks": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "start_week",
          "peak_week",
          "end_week",
          "share",
          "by_year",
          "shift_days_per_decade",
          "sentence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "start_week": {
            "type": "integer"
          },
          "peak_week": {
            "type": "integer"
          },
          "end_week": {
            "type": "integer"
          },
          "share": {
            "type": "number"
          },
          "by_year": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "year",
                "start_doy",
                "centroid_doy",
                "end_doy",
                "total",
                "kind"
              ],
              "properties": {
                "year": {
                  "type": "integer"
                },
                "start_doy": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "centroid_doy": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "end_doy": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "total": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "observed",
                    "harmonized",
                    "estimated",
                    "missing",
                    "sample"
                  ]
                }
              }
            }
          },
          "shift_days_per_decade": {
            "type": "object",
            "required": [
              "start",
              "centroid",
              "end"
            ],
            "properties": {
              "start": {
                "type": "object",
                "required": [
                  "value",
                  "lo",
                  "hi"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "lo": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "hi": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "centroid": {
                "type": "object",
                "required": [
                  "value",
                  "lo",
                  "hi"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "lo": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "hi": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "end": {
                "type": "object",
                "required": [
                  "value",
                  "lo",
                  "hi"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "lo": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "hi": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "sentence": {
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "maxItems": 2
    }
  }
}

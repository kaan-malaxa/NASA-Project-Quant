{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trend (TEMPORARY, R5; replace with contracts/trend.schema.json from R1)",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "code_version",
    "region",
    "years",
    "annual",
    "harmonized",
    "naive",
    "robustness",
    "sentence_id",
    "sentence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "years": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "annual": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "year",
          "harmonized",
          "lo",
          "hi",
          "kind",
          "naive_count",
          "naive_source"
        ],
        "properties": {
          "year": {
            "type": "integer"
          },
          "harmonized": {
            "type": [
              "number",
              "null"
            ]
          },
          "lo": {
            "type": [
              "number",
              "null"
            ]
          },
          "hi": {
            "type": [
              "number",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "observed",
              "harmonized",
              "estimated",
              "missing",
              "sample"
            ]
          },
          "naive_count": {
            "type": [
              "number",
              "null"
            ]
          },
          "naive_source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "harmonized": {
      "type": "object",
      "required": [
        "pct_per_decade",
        "lo",
        "hi",
        "direction"
      ],
      "properties": {
        "pct_per_decade": {
          "type": [
            "number",
            "null"
          ]
        },
        "lo": {
          "type": [
            "number",
            "null"
          ]
        },
        "hi": {
          "type": [
            "number",
            "null"
          ]
        },
        "direction": {
          "enum": [
            "rising",
            "falling",
            "no_clear_change"
          ]
        }
      }
    },
    "naive": {
      "type": "object",
      "required": [
        "pct_per_decade",
        "lo",
        "hi",
        "direction"
      ],
      "properties": {
        "pct_per_decade": {
          "type": [
            "number",
            "null"
          ]
        },
        "lo": {
          "type": [
            "number",
            "null"
          ]
        },
        "hi": {
          "type": [
            "number",
            "null"
          ]
        },
        "direction": {
          "enum": [
            "rising",
            "falling",
            "no_clear_change"
          ]
        }
      }
    },
    "robustness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variant",
          "pct_per_decade",
          "lo",
          "hi",
          "direction"
        ],
        "properties": {
          "variant": {
            "type": "string"
          },
          "pct_per_decade": {
            "type": [
              "number",
              "null"
            ]
          },
          "lo": {
            "type": [
              "number",
              "null"
            ]
          },
          "hi": {
            "type": [
              "number",
              "null"
            ]
          },
          "direction": {
            "enum": [
              "rising",
              "falling",
              "no_clear_change"
            ]
          }
        }
      }
    },
    "sentence_id": {
      "enum": [
        "artifact_flat",
        "artifact_rising",
        "artifact_falling",
        "agree",
        "unclear"
      ]
    },
    "sentence": {
      "type": "string"
    }
  }
}
